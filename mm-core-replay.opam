opam-version: "2.0"
synopsis: "Run the mm-core strategy over recorded market data"
description:
  "Replays normalized event logs of market-data through the mm-core strategy and prints the quotes it would send per book update. The mm-core binary."
maintainer: ["winterchill-trading"]
authors: ["winterchill-trading"]
license: "MIT"
homepage: "https://github.com/winterchill-trading/mm-core"
bug-reports: "https://github.com/winterchill-trading/mm-core/issues"
depends: [
  "ocaml"
  "dune" {>= "3.17"}
  "core"
  "core_unix"
  "async"
  "exchange-core"
  "market-data"
  "mm-core"
  "ppx_jane"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/winterchill-trading/mm-core.git"
